generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ─── NextAuth Models ─────────────────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  passwordHash  String
  emailVerified DateTime?
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts      Account[]
  sessions      AuthSession[]
  memberships   WorkspaceMember[]
  configs       UserConfig[]
  analytics     AnalyticsEvent[]
  pageViews     PageView[]
  visitSessions VisitSession[]
  apiLogs       ApiLog[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

// Note: renamed from "Session" to "AuthSession" to avoid conflict with VisitSession
model AuthSession {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─── Workspaces ─────────────────────────────────────────────────────────────

model Workspace {
  id        String   @id @default(cuid())
  name      String             // 显示名称
  slug      String   @unique   // URL 友好标识（自动生成，不可改）
  plan      String   @default("free")  // free / pro
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members   WorkspaceMember[]
  configs   UserConfig[]
}

model WorkspaceMember {
  id          String   @id @default(cuid())
  workspaceId String
  userId      String
  role        String   @default("member")  // owner / admin / member
  joinedAt    DateTime @default(now())

  workspace  Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
}

// ─── User Config (saved AI configs) ─────────────────────────────────────────

model UserConfig {
  id          String   @id @default(cuid())
  userId      String   // 创建者
  workspaceId String   // 所属工作空间
  name        String
  configText  String
  answersJson String
  statsJson   String
  isPublic    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ─── Analytics Events ───────────────────────────────────────────────────────

model AnalyticsEvent {
  id         String   @id @default(cuid())
  userId     String?
  sessionId  String?
  eventName  String
  properties String?  // JSON string
  url        String?
  referrer   String?
  timestamp  DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)
}

// ─── Page Views ──────────────────────────────────────────────────────────────

/// 每次页面访问记录一条
model PageView {
  id          Int      @id @default(autoincrement())
  fingerprint String   @default("")   // 浏览器指纹（匿名用户标识）
  visitorIp   String   @default("")   // 访问者 IP
  path        String   @default("/")  // 页面路径，如 /features
  referrer    String   @default("")   // 来源页面
  userId      String?  @default("")   // 已登录用户 ID
  country     String?  @default("")   // 国家（可选，IP 解析）
  duration    Int      @default(0)    // 停留时长（秒，退出时上报）
  createdAt   DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([path, createdAt])
  @@index([fingerprint, createdAt])
}

// ─── Daily Aggregated Stats ─────────────────────────────────────────────────

/// 每日预聚合统计数据，加速仪表盘查询
model DailyStats {
  id             Int      @id @default(autoincrement())
  date           DateTime @db.Date              // 精确到天
  path           String   @default("")          // 页面路径（空=全站汇总）
  pv             Int      @default(0)          // 当日页面浏览量
  uv             Int      @default(0)          // 当日独立访客数
  quizStarted    Int      @default(0)          // 当日测评开始次数
  quizCompleted  Int      @default(0)          // 当日测评完成次数
  aiEnhanced     Int      @default(0)          // 当日 AI 增强使用次数
  avgDuration    Float    @default(0)          // 当日平均停留时长（秒）
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([date, path])
  @@index([date])
}

// ─── Visit Sessions ─────────────────────────────────────────────────────────

/// 追踪用户在站内的行为路径（一次会话一条记录）
model VisitSession {
  id          String   @id @default(cuid())  // 前端生成 UUID
  fingerprint String   @default("")           // 浏览器指纹
  visitorIp   String   @default("")
  userId      String?  @default("")
  firstPath   String   @default("/")         // 入口页面
  lastPath    String   @default("/")         // 最后浏览页面
  pageCount   Int      @default(1)           // 浏览页面数
  duration    Int      @default(0)           // 会话时长（秒）
  completed   Boolean  @default(false)       // 是否完成测评
  country     String?  @default("")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([fingerprint, createdAt])
  @@index([createdAt])
}

// ─── API Call Logs ───────────────────────────────────────────────────────────

/// 记录 AI 增强等关键接口调用情况
model ApiLog {
  id         Int       @id @default(autoincrement())
  userId     String?    @default("")
  fingerprint String?   @default("")
  endpoint   String     @default("")          // 如 /api/enhance
  model      String?    @default("")          // 使用的模型名
  duration   Int?       @default(0)           // 耗时（毫秒）
  status     Int        @default(200)        // HTTP 状态码
  errorMsg   String?    @default("")         // 错误信息（如果有）
  createdAt  DateTime   @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([endpoint, createdAt])
  @@index([status, createdAt])
}
